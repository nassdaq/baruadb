{
  "name": "barua-tasks",
  "version": "0.1.0",
  "description": "Durable background work for any application: enqueue, schedule, retry, and receive signed task deliveries. One file, no dependencies.",
  "type": "module",
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "background-jobs",
    "queue",
    "cron",
    "retry",
    "webhooks",
    "durable",
    "barua"
  ],
  "homepage": "https://barua.app/docs/tasks",
  "repository": {
    "type": "git",
    "url": "https://github.com/nassdaq/workingdb.git",
    "directory": "tasks/sdk"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
