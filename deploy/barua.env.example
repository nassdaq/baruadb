# /etc/barua/barua.env — written by install.sh. Restart after editing:
#   systemctl restart barua      (running databases keep running)

# ---- Cluster
BARUA_CONTROL_URL=https://pgapi.barua.tz
BARUA_JOIN_TOKEN=
BARUA_PUBLIC_IP=
BARUA_BOX_NAME=
BARUA_DOMAIN=pg.barua.tz

# ---- R2: the permanent home of every database
BARUA_R2_ACCOUNT_ID=
BARUA_R2_BUCKET=baruadb
BARUA_R2_ACCESS_KEY_ID=
BARUA_R2_SECRET_ACCESS_KEY=

# ---- TLS (wildcard certificate for *.pg.barua.tz)
BARUA_TLS_CERT=/etc/barua/tls/fullchain.pem
BARUA_TLS_KEY=/etc/barua/tls/privkey.pem

# ---- Paths and ports
BARUA_DATA=/var/lib/barua
BARUA_PG_BIN=/usr/lib/postgresql/16/bin
BARUA_PROXY_ADDR=0.0.0.0:5432
BARUA_API_ADDR=0.0.0.0:443

# ---- Behaviour (defaults shown)
# BARUA_SUSPEND_AFTER=300          # seconds idle before a database sleeps
# BARUA_MIN_FREE_DISK_PCT=20       # below this, sleeping databases move to R2 only
# BARUA_COLD_AFTER_HOURS=0         # also move databases asleep this long (0 = only on disk pressure)
# BARUA_SNAPSHOT_EVERY_HOURS=24
# BARUA_RETENTION_DAYS=7           # point-in-time restore window
# BARUA_DB_MEMORY_MAX=512M         # per-database memory limit (cgroup)
# BARUA_DB_CPU_MAX=100000 100000   # per-database CPU limit: 1 CPU
# BARUA_DB_MAX_CONNECTIONS=50
# BARUA_LOG=info
